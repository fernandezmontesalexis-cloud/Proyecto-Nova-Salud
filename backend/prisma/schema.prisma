// Modelo relacional de FarmaPlus y configuración del cliente Prisma.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PHARMACIST
  CASHIER
}

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  EXPIRED
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Supplier {
  id        Int           @id @default(autoincrement())
  name      String        @db.VarChar(150)
  document  String?       @unique @db.VarChar(20)
  phone     String?       @db.VarChar(30)
  email     String?       @db.VarChar(150)
  address   String?       @db.VarChar(255)
  createdAt DateTime      @default(now())
  lots      InventoryLot[]
}

model Product {
  id           Int                 @id @default(autoincrement())
  code         String              @unique @db.VarChar(40)
  name         String              @db.VarChar(180)
  description  String?             @db.Text
  unit         String              @default("unidad") @db.VarChar(30)
  purchaseCost Decimal             @default(0) @db.Decimal(10, 2)
  salePrice    Decimal             @db.Decimal(10, 2)
  minStock     Int                 @default(5)
  active       Boolean             @default(true)
  categoryId   Int
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  category     Category            @relation(fields: [categoryId], references: [id])
  lots         InventoryLot[]
  saleItems    SaleItem[]
  movements    InventoryMovement[]

  @@index([name])
}

model InventoryLot {
  id          Int                 @id @default(autoincrement())
  productId   Int
  supplierId  Int?
  lotCode     String              @db.VarChar(60)
  expiresAt   DateTime?           @db.Date
  quantity    Int                 @default(0)
  receivedAt  DateTime            @default(now())
  product     Product             @relation(fields: [productId], references: [id])
  supplier    Supplier?           @relation(fields: [supplierId], references: [id])
  saleItems   SaleItem[]
  movements   InventoryMovement[]

  @@unique([productId, lotCode])
  @@index([expiresAt, quantity])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  document  String?  @unique @db.VarChar(20)
  phone     String?  @db.VarChar(30)
  email     String?  @db.VarChar(150)
  createdAt DateTime @default(now())
  sales     Sale[]
}

model User {
  id           Int                 @id @default(autoincrement())
  name         String              @db.VarChar(120)
  email        String              @unique @db.VarChar(150)
  passwordHash String              @db.VarChar(255)
  role         UserRole            @default(CASHIER)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  sales        Sale[]
  movements    InventoryMovement[]
}

model Sale {
  id         Int        @id @default(autoincrement())
  number     String     @unique @db.VarChar(30)
  customerId Int?
  userId     Int?
  subtotal   Decimal    @db.Decimal(10, 2)
  tax        Decimal    @default(0) @db.Decimal(10, 2)
  total      Decimal    @db.Decimal(10, 2)
  createdAt  DateTime   @default(now())
  customer   Customer?  @relation(fields: [customerId], references: [id])
  user       User?      @relation(fields: [userId], references: [id])
  items      SaleItem[]

  @@index([createdAt])
}

model SaleItem {
  id        Int          @id @default(autoincrement())
  saleId    Int
  productId Int
  lotId     Int
  quantity  Int
  unitPrice Decimal      @db.Decimal(10, 2)
  lineTotal Decimal      @db.Decimal(10, 2)
  sale      Sale         @relation(fields: [saleId], references: [id])
  product   Product      @relation(fields: [productId], references: [id])
  lot       InventoryLot @relation(fields: [lotId], references: [id])
}

model InventoryMovement {
  id        Int          @id @default(autoincrement())
  productId Int
  lotId     Int?
  userId    Int?
  type      MovementType
  quantity  Int
  note      String?      @db.VarChar(255)
  createdAt DateTime     @default(now())
  product   Product      @relation(fields: [productId], references: [id])
  lot       InventoryLot? @relation(fields: [lotId], references: [id])
  user      User?        @relation(fields: [userId], references: [id])

  @@index([productId, createdAt])
}
